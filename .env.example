# Copier ce fichier en .env puis adapter les valeurs. Le fichier .env n'est pas versionné.

# Compte Docker Hub qui porte les images pmt-backend et pmt-frontend
DOCKERHUB_USERNAME=hybripat

# Version des images à lancer (latest ou l'empreinte d'un commit)
IMAGE_TAG=latest

# Mot de passe de la base PostgreSQL
POSTGRES_PASSWORD=pmt
